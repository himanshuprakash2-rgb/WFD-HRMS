<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(MainLayout)">
            <div class="max-w-2xl mx-auto my-12 p-8 bg-white border border-slate-200 rounded-xl shadow-sm text-center">
                <h2 class="text-2xl font-bold text-slate-800 mb-2">Page Not Found</h2>
                <p class="text-slate-600 mb-6 text-base">The requested page could not be located.</p>
                <a href="/onboarding" class="inline-flex items-center px-6 py-3 bg-brand-primary text-white font-medium rounded-lg hover:bg-brand-accent transition shadow-sm">
                    Back to Onboarding Requests
                </a>
            </div>
        </LayoutView>
    </NotFound>
</Router>
