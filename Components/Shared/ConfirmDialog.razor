@if (IsOpen)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-slate-900/40 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-xl max-w-lg w-full p-6 border border-slate-200">
            <h3 class="text-xl font-bold text-slate-800 mb-2">@Title</h3>
            <p class="text-slate-600 mb-4 text-base">@Message</p>

            @if (RequireInput)
            {
                <div class="mb-4">
                    <label class="block text-sm font-medium text-slate-700 mb-1">
                        @InputLabel
                        @if (IsInputMandatory)
                        {
                            <span class="text-red-500 font-semibold">*</span>
                        }
                    </label>
                    <textarea @bind="InputValue"
                              rows="3"
                              placeholder="@InputPlaceholder"
                              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-accent text-slate-800"></textarea>
                    @if (showInputError)
                    {
                        <p class="text-red-600 text-sm mt-1">@InputErrorMessage</p>
                    }
                </div>
            }

            <div class="flex items-center justify-end space-x-3 mt-6">
                <button type="button"
                        @onclick="CancelAsync"
                        class="px-5 py-2.5 rounded-lg border border-slate-300 text-slate-700 hover:bg-slate-50 font-medium transition">
                    @CancelButtonText
                </button>
                <button type="button"
                        @onclick="ConfirmAsync"
                        class="px-5 py-2.5 rounded-lg @ConfirmButtonClass text-white font-medium transition shadow-sm">
                    @ConfirmButtonText
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string Title { get; set; } = "Confirm Action";
    [Parameter] public string Message { get; set; } = "Are you sure you want to proceed?";
    [Parameter] public string ConfirmButtonText { get; set; } = "Confirm";
    [Parameter] public string CancelButtonText { get; set; } = "Cancel";
    [Parameter] public string ConfirmButtonClass { get; set; } = "bg-brand-primary hover:bg-brand-accent";

    [Parameter] public bool RequireInput { get; set; }
    [Parameter] public bool IsInputMandatory { get; set; }
    [Parameter] public string InputLabel { get; set; } = "Remarks";
    [Parameter] public string InputPlaceholder { get; set; } = "Enter details here...";
    [Parameter] public string InputErrorMessage { get; set; } = "This field is required.";

    [Parameter] public EventCallback<string> OnConfirmed { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }

    public string InputValue { get; set; } = string.Empty;
    private bool showInputError = false;

    private async Task ConfirmAsync()
    {
        if (RequireInput && IsInputMandatory && string.IsNullOrWhiteSpace(InputValue))
        {
            showInputError = true;
            return;
        }

        showInputError = false;
        await OnConfirmed.InvokeAsync(InputValue);
        InputValue = string.Empty;
    }

    private async Task CancelAsync()
    {
        showInputError = false;
        InputValue = string.Empty;
        await OnCancelled.InvokeAsync();
    }
}
