@page "/admin/user-roles/edit/{UserId}"
@attribute [Authorize(Policy = AppPermissions.CanManageRbac)]

<div class="max-w-2xl mx-auto space-y-6">
    <!-- Breadcrumb & Header -->
    <div>
        <div class="mb-2">
            <a href="/admin/user-roles" class="inline-flex items-center text-xs font-semibold text-brand-primary hover:underline">
                &larr; Back to User Role Assignments
            </a>
        </div>
        <h1 class="text-2xl font-bold text-slate-800">
            Edit Security Roles
        </h1>
        @if (user != null)
        {
            <p class="text-slate-600 text-sm mt-0.5">
                Assign or revoke roles for <strong class="text-slate-800">@user.FullName</strong>
                <span class="font-mono text-xs text-slate-500">(@user.UserName &bull; @user.Email)</span>
            </p>
        }
    </div>

    @if (isLoading)
    {
        <div class="p-8 text-center text-slate-400 bg-white border border-slate-200 rounded-xl shadow-sm">
            Loading user role assignments...
        </div>
    }
    else if (user == null)
    {
        <div class="p-8 text-center text-slate-500 bg-white border border-slate-200 rounded-xl shadow-sm">
            User not found.
        </div>
    }
    else
    {
        <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-6 space-y-6">
            <div>
                <h2 class="text-base font-bold text-slate-800 mb-1">Available System Roles</h2>
                <p class="text-xs text-slate-500 mb-4">
                    Check the security roles this user should belong to. Permissions mapped to these roles will be granted dynamically.
                </p>

                <div class="space-y-3">
                    @foreach (var role in allRoles)
                    {
                        var roleName = role.Name ?? "";
                        var isChecked = selectedRoles.Contains(roleName);
                        <label class="flex items-center p-3.5 rounded-lg border cursor-pointer transition @(isChecked ? "border-brand-primary bg-blue-50/20" : "border-slate-200 hover:bg-slate-50")">
                            <input type="checkbox"
                                   checked="@isChecked"
                                   @onchange="(e) => ToggleRole(roleName, (bool)(e.Value ?? false))"
                                   class="w-4 h-4 text-brand-primary rounded border-slate-300 focus:ring-brand-accent" />
                            <div class="ml-3">
                                <span class="text-sm font-semibold text-slate-800">@roleName</span>
                            </div>
                        </label>
                    }
                </div>
            </div>

            <div class="flex items-center justify-end space-x-3 pt-4 border-t border-slate-100">
                <a href="/admin/user-roles"
                   class="px-5 py-2.5 border border-slate-300 text-slate-700 hover:bg-slate-50 rounded-lg text-sm font-medium transition">
                    Cancel
                </a>
                <button type="button"
                        @onclick="SaveUserRolesAsync"
                        disabled="@isSaving"
                        class="px-5 py-2.5 bg-brand-primary hover:bg-brand-accent text-white rounded-lg text-sm font-medium transition shadow-sm disabled:opacity-50">
                    @(isSaving ? "Saving Roles..." : "Save Roles")
                </button>
            </div>
        </div>
    }
</div>
