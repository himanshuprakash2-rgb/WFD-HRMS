@page "/admin/roles/new"
@attribute [Authorize(Policy = AppPermissions.CanManageRbac)]

<div class="max-w-xl mx-auto space-y-6">
    <!-- Breadcrumb & Header -->
    <div>
        <div class="mb-2">
            <a href="/admin/roles" class="inline-flex items-center text-xs font-semibold text-brand-primary hover:underline">
                &larr; Back to Application Roles
            </a>
        </div>
        <h1 class="text-2xl font-bold text-slate-800">
            Create New Role
        </h1>
        <p class="text-slate-600 text-sm mt-0.5">
            Define a new security role and organizational job group for permission assignments.
        </p>
    </div>

    <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-6 space-y-6">
        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">
                Role Name <span class="text-red-500">*</span>
            </label>
            <input type="text"
                   @bind="newRoleName"
                   placeholder="e.g. RegionalAuditor"
                   class="w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-accent focus:outline-none text-slate-800 text-sm" />
            <p class="text-xs text-slate-400 mt-1">Unique system identifier for the role (alphanumeric without spaces recommended).</p>
        </div>

        <div class="flex items-center justify-end space-x-3 pt-4 border-t border-slate-100">
            <a href="/admin/roles"
               class="px-5 py-2.5 border border-slate-300 text-slate-700 hover:bg-slate-50 rounded-lg text-sm font-medium transition">
                Cancel
            </a>
            <button type="button"
                    @onclick="CreateRoleAsync"
                    disabled="@isSaving"
                    class="px-5 py-2.5 bg-brand-primary hover:bg-brand-accent text-white rounded-lg text-sm font-medium transition shadow-sm disabled:opacity-50">
                @(isSaving ? "Creating Role..." : "Create Role")
            </button>
        </div>
    </div>
</div>
