@page "/admin/user-branches"
@attribute [Authorize(Policy = AppPermissions.CanManageMasterData)]

<div class="space-y-6">
    <div>
        <h1 class="text-2xl font-bold text-slate-800">User-Branch Assignments</h1>
        <p class="text-slate-600 text-sm mt-1">
            Assign supervisors and staff to branches. Supervisors will only have visibility over requests for their assigned branches.
        </p>
    </div>

    <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-6 space-y-6">
        <!-- User Selector -->
        <div class="max-w-md">
            <label class="block text-sm font-semibold text-slate-700 mb-2">Select User</label>
            <select @bind="selectedUserId" @bind:after="OnUserSelectedAsync"
                    class="w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-accent focus:outline-none text-slate-800 font-medium">
                <option value="">-- Select a User --</option>
                @foreach (var u in users)
                {
                    <option value="@u.Id">@u.FullName (@u.UserName)</option>
                }
            </select>
        </div>

        @if (!string.IsNullOrEmpty(selectedUserId))
        {
            <div class="border-t border-slate-200 pt-6">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h2 class="text-base font-bold text-slate-800">Assigned Branches</h2>
                        <p class="text-xs text-slate-500">Check each branch this user is authorized to manage and submit onboarding for.</p>
                    </div>
                    <button type="button"
                            @onclick="SaveAssignmentsAsync"
                            class="px-5 py-2.5 bg-brand-primary hover:bg-brand-accent text-white font-medium rounded-lg transition shadow-sm">
                        Save Assignments
                    </button>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                    @foreach (var b in allBranches)
                    {
                        var isChecked = selectedBranchIds.Contains(b.Id);
                        <label class="flex items-start p-3.5 rounded-lg border cursor-pointer transition @(isChecked ? "border-brand-primary bg-blue-50/30" : "border-slate-200 hover:bg-slate-50")">
                            <input type="checkbox"
                                   checked="@isChecked"
                                   @onchange="(e) => ToggleBranchSelection(b.Id, (bool)(e.Value ?? false))"
                                   class="w-4 h-4 mt-0.5 text-brand-primary rounded border-slate-300 focus:ring-brand-accent" />
                            <div class="ml-3">
                                <span class="font-mono text-xs font-bold text-brand-primary">@b.Code</span>
                                <div class="text-sm font-medium text-slate-800">@b.Name</div>
                                @if (!b.IsActive)
                                {
                                    <span class="text-[11px] text-amber-700 font-semibold">(Branch is currently inactive)</span>
                                }
                            </div>
                        </label>
                    }
                </div>
            </div>
        }
    </div>
</div>
