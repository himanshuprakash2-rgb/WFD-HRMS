@page "/onboarding/new"
@page "/onboarding/edit/{Id:guid}"
@attribute [Authorize(Policy = AppPermissions.CanCreateOnboarding)]

<div class="max-w-4xl mx-auto space-y-6">
    <!-- Breadcrumb & Header -->
    <div class="flex items-center justify-between">
        <div>
            <div class="text-xs font-semibold text-brand-primary mb-1">
                <a href="/onboarding" class="hover:underline">&larr; Back to Onboarding List</a>
            </div>
            <h1 class="text-2xl font-bold text-slate-800">
                @(Id == null ? "New Candidate Onboarding" : "Edit Onboarding Request")
            </h1>
            <p class="text-slate-600 text-sm mt-0.5">
                Complete candidate details, identity verification, and upload required documents.
            </p>
        </div>

        @if (model.Id != Guid.Empty && !string.IsNullOrEmpty(model.Status))
        {
            <StatusBadge Status="@model.Status" />
        }
    </div>

    @if (!string.IsNullOrEmpty(model.ReviewerRemarks))
    {
        <div class="p-4 bg-orange-50 border border-orange-200 rounded-lg">
            <h4 class="text-sm font-bold text-orange-900 mb-1">Reviewer Remarks / Revision Instructions</h4>
            <p class="text-sm text-orange-800">@model.ReviewerRemarks</p>
        </div>
    }

    <!-- Edit Form -->
    <EditForm Model="@model" OnValidSubmit="HandleSubmitAsync" class="space-y-6">
        <DataAnnotationsValidator />

        <!-- Section 1: Branch & Payroll Assignment -->
        <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-6 space-y-4">
            <h2 class="text-base font-bold text-slate-800 border-b border-slate-100 pb-2">
                1. Branch &amp; Payroll Assignment
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">
                        Assigned Branch <span class="text-red-500">*</span>
                    </label>
                    <select @bind="model.BranchId" @bind:after="OnBranchChangedAsync"
                            class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-accent focus:outline-none text-slate-800">
                        <option value="0">-- Select Branch --</option>
                        @foreach (var b in userBranches)
                        {
                            <option value="@b.Id">@b.Name (@b.Code)</option>
                        }
                    </select>
                    <ValidationMessage For="@(() => model.BranchId)" class="text-red-600 text-xs mt-1" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">
                        Payroll Processing Firm <span class="text-red-500">*</span>
                    </label>
                    <select @bind="model.SelectedPayrollFirmId"
                            disabled="@(validPayrollFirms.Count == 0)"
                            class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-accent focus:outline-none text-slate-800 disabled:bg-slate-100">
                        <option value="0">-- Select Payroll Firm --</option>
                        @foreach (var p in validPayrollFirms)
                        {
                            <option value="@p.Id">@p.Name (@p.Code)</option>
                        }
                    </select>
                    <ValidationMessage For="@(() => model.SelectedPayrollFirmId)" class="text-red-600 text-xs mt-1" />
                    @if (model.BranchId > 0 && validPayrollFirms.Count == 0)
                    {
                        <p class="text-amber-700 text-xs mt-1">No active payroll firms are currently mapped to this branch.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Section 2: Candidate Personal Information -->
        <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-6 space-y-4">
            <h2 class="text-base font-bold text-slate-800 border-b border-slate-100 pb-2">
                2. Personal Details
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">
                        Full Name (as per Aadhaar) <span class="text-red-500">*</span>
                    </label>
                    <InputText @bind-Value="model.FullName"
                               placeholder="e.g. Rahul Sharma"
                               class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-accent focus:outline-none text-slate-800" />
                    <ValidationMessage For="@(() => model.FullName)" class="text-red-600 text-xs mt-1" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">
                        Date of Birth <span class="text-red-500">*</span>
                    </label>
                    <InputDate @bind-Value="model.DateOfBirth"
                               class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-accent focus:outline-none text-slate-800" />
                    <ValidationMessage For="@(() => model.DateOfBirth)" class="text-red-600 text-xs mt-1" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">
                        Designation / Role <span class="text-red-500">*</span>
                    </label>
                    <InputText @bind-Value="model.Designation"
                               placeholder="e.g. Sales Executive"
                               class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-accent focus:outline-none text-slate-800" />
                    <ValidationMessage For="@(() => model.Designation)" class="text-red-600 text-xs mt-1" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">
                        Mobile Number <span class="text-red-500">*</span>
                    </label>
                    <InputText @bind-Value="model.MobileNumber"
                               placeholder="10-digit mobile number"
                               class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-accent focus:outline-none text-slate-800" />
                    <ValidationMessage For="@(() => model.MobileNumber)" class="text-red-600 text-xs mt-1" />
                </div>
            </div>
        </div>

        <!-- Section 3: Identity & Fraud Check (Aadhaar & PAN) -->
        <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-6 space-y-4">
            <h2 class="text-base font-bold text-slate-800 border-b border-slate-100 pb-2">
                3. Identity Credentials &amp; Verification
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">
                        Aadhaar Number (12 Digits) <span class="text-red-500">*</span>
                    </label>
                    <input type="text"
                           @bind="model.AadhaarNumber"
                           @bind:after="CheckDuplicateAndFraudAsync"
                           maxlength="12"
                           placeholder="12-digit number"
                           class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-accent focus:outline-none font-mono text-slate-800" />
                    <ValidationMessage For="@(() => model.AadhaarNumber)" class="text-red-600 text-xs mt-1" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">
                        Permanent Account Number (PAN) <span class="text-red-500">*</span>
                    </label>
                    <input type="text"
                           @bind="model.PanNumber"
                           @bind:after="CheckDuplicateAndFraudAsync"
                           maxlength="10"
                           placeholder="10-character alphanumeric"
                           class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-accent focus:outline-none uppercase font-mono text-slate-800" />
                    <ValidationMessage For="@(() => model.PanNumber)" class="text-red-600 text-xs mt-1" />
                </div>
            </div>

            @if (!string.IsNullOrEmpty(identityConflictWarning))
            {
                <div class="p-3.5 bg-rose-50 border border-rose-300 rounded-lg text-rose-800 text-sm font-medium flex items-start space-x-2">
                    <svg class="w-5 h-5 text-rose-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                    </svg>
                    <div>@identityConflictWarning</div>
                </div>
            }
        </div>

        <!-- Section 4: Bank Account Details -->
        <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-6 space-y-4">
            <h2 class="text-base font-bold text-slate-800 border-b border-slate-100 pb-2">
                4. Bank Account Details
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">
                        Bank Account Number <span class="text-red-500">*</span>
                    </label>
                    <InputText @bind-Value="model.BankAccountNumber"
                               placeholder="e.g. 123456789012"
                               class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-accent focus:outline-none font-mono text-slate-800" />
                    <ValidationMessage For="@(() => model.BankAccountNumber)" class="text-red-600 text-xs mt-1" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">
                        Bank IFSC Code <span class="text-red-500">*</span>
                    </label>
                    <InputText @bind-Value="model.BankIfscCode"
                               placeholder="e.g. SBIN0001234"
                               class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-accent focus:outline-none uppercase font-mono text-slate-800" />
                    <ValidationMessage For="@(() => model.BankIfscCode)" class="text-red-600 text-xs mt-1" />
                </div>
            </div>
        </div>

        <!-- Section 5: Document Uploads & Client-Side WebP Compression -->
        <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-6 space-y-4">
            <div class="border-b border-slate-100 pb-2 flex items-center justify-between">
                <div>
                    <h2 class="text-base font-bold text-slate-800">
                        5. Mandatory Document Uploads
                    </h2>
                    <p class="text-xs text-slate-500">
                        Converted &amp; compressed to WebP (max 2 MB) directly in the browser before upload.
                    </p>
                </div>
                <span class="text-xs font-semibold px-2 py-1 bg-blue-50 text-brand-primary rounded">
                    @model.Attachments.Count / 3 Uploaded
                </span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <!-- Aadhaar Card -->
                <div class="p-4 rounded-lg border border-slate-200 bg-slate-50/50 space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="text-sm font-bold text-slate-800">Aadhaar Card</span>
                        @if (HasAttachment(DocumentTypes.AadhaarCard))
                        {
                            <span class="text-xs font-semibold text-emerald-700 flex items-center">
                                &check; Uploaded
                            </span>
                        }
                    </div>

                    @if (HasAttachment(DocumentTypes.AadhaarCard))
                    {
                        var att = GetAttachment(DocumentTypes.AadhaarCard);
                        <div class="relative group rounded overflow-hidden border border-slate-200 bg-white">
                            @if (att != null && att.FileUrl.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="h-28 w-full flex flex-col items-center justify-center bg-rose-50 border border-rose-200 rounded p-2 text-center">
                                    <span class="text-rose-600 font-bold text-xs uppercase">PDF Document</span>
                                    <a href="@att.FileUrl" target="_blank" class="text-brand-primary hover:underline text-xs mt-1 font-medium">View PDF &rarr;</a>
                                </div>
                            }
                            else
                            {
                                <img src="@att?.FileUrl" alt="Aadhaar" class="h-28 w-full object-cover" />
                            }
                            <div class="text-[10px] text-slate-500 px-2 py-1">
                                @((att?.FileSizeBytes ?? 0) / 1024) KB
                            </div>
                        </div>
                    }

                    <div>
                        <label class="block text-xs font-medium text-slate-600 mb-1">
                            @(HasAttachment(DocumentTypes.AadhaarCard) ? "Replace File:" : "Select File:")
                        </label>
                        <InputFile OnChange="@(e => HandleFileSelected(e, DocumentTypes.AadhaarCard))"
                                   accept="image/jpeg,image/png,image/webp,application/pdf"
                                   class="text-xs text-slate-500 file:mr-2 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-brand-primary file:text-white hover:file:bg-brand-accent cursor-pointer" />
                    </div>
                </div>

                <!-- PAN Card -->
                <div class="p-4 rounded-lg border border-slate-200 bg-slate-50/50 space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="text-sm font-bold text-slate-800">PAN Card</span>
                        @if (HasAttachment(DocumentTypes.PanCard))
                        {
                            <span class="text-xs font-semibold text-emerald-700 flex items-center">
                                &check; Uploaded
                            </span>
                        }
                    </div>

                    @if (HasAttachment(DocumentTypes.PanCard))
                    {
                        var att = GetAttachment(DocumentTypes.PanCard);
                        <div class="relative group rounded overflow-hidden border border-slate-200 bg-white">
                            @if (att != null && att.FileUrl.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="h-28 w-full flex flex-col items-center justify-center bg-rose-50 border border-rose-200 rounded p-2 text-center">
                                    <span class="text-rose-600 font-bold text-xs uppercase">PDF Document</span>
                                    <a href="@att.FileUrl" target="_blank" class="text-brand-primary hover:underline text-xs mt-1 font-medium">View PDF &rarr;</a>
                                </div>
                            }
                            else
                            {
                                <img src="@att?.FileUrl" alt="PAN Card" class="h-28 w-full object-cover" />
                            }
                            <div class="text-[10px] text-slate-500 px-2 py-1">
                                @((att?.FileSizeBytes ?? 0) / 1024) KB
                            </div>
                        </div>
                    }

                    <div>
                        <label class="block text-xs font-medium text-slate-600 mb-1">
                            @(HasAttachment(DocumentTypes.PanCard) ? "Replace File:" : "Select File:")
                        </label>
                        <InputFile OnChange="@(e => HandleFileSelected(e, DocumentTypes.PanCard))"
                                   accept="image/jpeg,image/png,image/webp,application/pdf"
                                   class="text-xs text-slate-500 file:mr-2 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-brand-primary file:text-white hover:file:bg-brand-accent cursor-pointer" />
                    </div>
                </div>

                <!-- Bank Passbook -->
                <div class="p-4 rounded-lg border border-slate-200 bg-slate-50/50 space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="text-sm font-bold text-slate-800">Bank Passbook</span>
                        @if (HasAttachment(DocumentTypes.BankPassbook))
                        {
                            <span class="text-xs font-semibold text-emerald-700 flex items-center">
                                &check; Uploaded
                            </span>
                        }
                    </div>

                    @if (HasAttachment(DocumentTypes.BankPassbook))
                    {
                        var att = GetAttachment(DocumentTypes.BankPassbook);
                        <div class="relative group rounded overflow-hidden border border-slate-200 bg-white">
                            @if (att != null && att.FileUrl.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="h-28 w-full flex flex-col items-center justify-center bg-rose-50 border border-rose-200 rounded p-2 text-center">
                                    <span class="text-rose-600 font-bold text-xs uppercase">PDF Document</span>
                                    <a href="@att.FileUrl" target="_blank" class="text-brand-primary hover:underline text-xs mt-1 font-medium">View PDF &rarr;</a>
                                </div>
                            }
                            else
                            {
                                <img src="@att?.FileUrl" alt="Bank Passbook" class="h-28 w-full object-cover" />
                            }
                            <div class="text-[10px] text-slate-500 px-2 py-1">
                                @((att?.FileSizeBytes ?? 0) / 1024) KB
                            </div>
                        </div>
                    }

                    <div>
                        <label class="block text-xs font-medium text-slate-600 mb-1">
                            @(HasAttachment(DocumentTypes.BankPassbook) ? "Replace File:" : "Select File:")
                        </label>
                        <InputFile OnChange="@(e => HandleFileSelected(e, DocumentTypes.BankPassbook))"
                                   accept="image/jpeg,image/png,image/webp,application/pdf"
                                   class="text-xs text-slate-500 file:mr-2 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-brand-primary file:text-white hover:file:bg-brand-accent cursor-pointer" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Form Action Buttons -->
        <div class="flex items-center justify-between pt-4">
            <a href="/onboarding" class="px-5 py-2.5 rounded-lg border border-slate-300 text-slate-700 hover:bg-slate-50 font-medium transition">
                Cancel
            </a>

            <div class="flex items-center space-x-3">
                <button type="button"
                        @onclick="SaveDraftAsync"
                        disabled="@isProcessing"
                        class="px-5 py-2.5 rounded-lg border border-brand-primary text-brand-primary hover:bg-blue-50 font-medium transition disabled:opacity-50">
                    Save Draft (Attachments Optional)
                </button>

                <button type="submit"
                        disabled="@isProcessing"
                        class="px-6 py-2.5 bg-brand-primary hover:bg-brand-accent text-white font-medium rounded-lg shadow-sm transition disabled:opacity-50">
                    Submit for Approval
                </button>
            </div>
        </div>
    </EditForm>
</div>
