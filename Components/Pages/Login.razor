@page "/"
@page "/Account/Login"

<div class="min-h-screen flex flex-col lg:flex-row bg-slate-50">
    <!-- Left 70% Enterprise Branding & Feature Showcase -->
    <div class="w-full lg:w-[70%] bg-gradient-to-br from-[#1b6ec2] via-[#15599c] to-[#0b3b6f] text-white p-8 sm:p-12 lg:p-16 flex flex-col justify-between relative overflow-hidden">
        <!-- Background Ambient Accents -->
        <div class="absolute -top-24 -left-24 w-96 h-96 bg-blue-400/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-sky-300/10 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Brand Header -->
        <div class="relative z-10">
            <div class="flex items-center space-x-3 mb-2">
                <div class="w-10 h-10 rounded-xl bg-white text-brand-primary flex items-center justify-center font-black text-xl shadow-md">
                    S
                </div>
                <div>
                    <span class="text-2xl font-black tracking-tight text-white block">SWIFT HRMS</span>

                </div>
            </div>
        </div>

        <!-- Hero Content & Tagline -->
        <div class="relative z-10 my-12 max-w-3xl">
            <div class="inline-flex items-center px-3 py-1 bg-white/10 backdrop-blur-sm rounded-full text-xs font-semibold text-blue-100 mb-4 border border-white/15">
                Security Workers Information & Finance Tool
            </div>

            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight leading-tight mb-4">
                Unified Operations, Multi-Branch Payroll
            </h1>

            <p class="text-blue-100 text-base sm:text-lg leading-relaxed mb-10 max-w-2xl">
                Purpose-built system engineered for workforce deployments, real-time muster reconciliation, and central management across all branches.
            </p>

            <!-- Key Features Showcase Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <!-- Feature 1 -->
                <div class="p-4 rounded-xl bg-white/10 backdrop-blur-sm border border-white/15">
                    <div class="flex items-center space-x-2 text-white font-bold text-sm mb-1">
                        <span class="text-base">🕒</span>
                        <span>Centralized Attendance</span>
                    </div>
                    <p class="text-xs text-blue-100 leading-relaxed">
                        Real-time biometric muster synchronization.
                    </p>
                </div>

                <!-- Feature 2 -->
                <div class="p-4 rounded-xl bg-white/10 backdrop-blur-sm border border-white/15">
                    <div class="flex items-center space-x-2 text-white font-bold text-sm mb-1">
                        <span class="text-base">📅</span>
                        <span>Leaves &amp; Rostering</span>
                    </div>
                    <p class="text-xs text-blue-100 leading-relaxed">
                        Structured leave workflows, duty replacement scheduling, and automated statutory holiday compensation tracking.
                    </p>
                </div>

                <!-- Feature 3 -->
                <div class="p-4 rounded-xl bg-white/10 backdrop-blur-sm border border-white/15">
                    <div class="flex items-center space-x-2 text-white font-bold text-sm mb-1">
                        <span class="text-base">🔄</span>
                        <span>Workforce Transfers</span>
                    </div>
                    <p class="text-xs text-blue-100 leading-relaxed">
                        Controlled inter-branch transfers and deputations with seamless payroll migration and historical audit tracking.
                    </p>
                </div>

                <!-- Feature 4 -->
                <div class="p-4 rounded-xl bg-white/10 backdrop-blur-sm border border-white/15">
                    <div class="flex items-center space-x-2 text-white font-bold text-sm mb-1">
                        <span class="text-base">🛡️</span>
                        <span>Identity Fraud Prevention</span>
                    </div>
                    <p class="text-xs text-blue-100 leading-relaxed">
                        Real-time 1:1 Aadhaar–PAN cross-branch locking, client-side WebP document compression, and duplicate protection.
                    </p>
                </div>
            </div>
        </div>

        <!-- Left Footer -->
        <div class="relative z-10 pt-6 border-t border-white/15 text-xs text-blue-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
            <span>&copy; @DateTime.UtcNow.Year SWIFT HRMS &bull; Security Workers Information &amp; Finance Tool</span>
            <span>Version 2.0 &bull; Enterprise Edition</span>
        </div>
    </div>

    <!-- Right 30% Modern Clean Login Panel -->
    <div class="w-full lg:w-[30%] bg-white p-8 sm:p-12 flex flex-col justify-between border-l border-slate-200">
        <div></div>

        <div class="max-w-sm w-full mx-auto my-auto">
            <div class="mb-8">
                <h2 class="text-2xl font-black text-slate-800 tracking-tight">Portal Sign In</h2>
                <p class="text-slate-500 text-sm mt-1">
                    Enter your administrative or staff credentials to access your workspace.
                </p>
            </div>

            @if (hasLoginError)
            {
                <div class="p-4 bg-rose-50 border border-rose-200 rounded-xl text-rose-800 text-xs font-semibold mb-6 flex items-start space-x-2">
                    <svg class="w-4 h-4 text-rose-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                    </svg>
                    <div>Invalid username or password. Please verify your credentials.</div>
                </div>
            }

            <!-- Pure Login Form -->
            <form method="post" action="/Account/Login" class="space-y-5">
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                        Username
                    </label>
                    <input type="text"
                           name="username"
                           required
                           autofocus
                           placeholder="Enter your username"
                           class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-brand-accent focus:border-brand-accent focus:outline-none text-slate-800 text-sm font-medium transition" />
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                        Password
                    </label>
                    <input type="password"
                           name="password"
                           required
                           placeholder="Enter your password"
                           class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-brand-accent focus:border-brand-accent focus:outline-none text-slate-800 text-sm font-medium transition" />
                </div>

                <div class="flex items-center justify-between text-xs">
                    <label class="flex items-center text-slate-600 cursor-pointer">
                        <input type="checkbox" name="rememberMe" class="w-4 h-4 text-brand-primary rounded border-slate-300 focus:ring-brand-accent" />
                        <span class="ml-2 font-medium">Keep me signed in</span>
                    </label>
                </div>

                <button type="submit"
                        class="w-full py-3.5 px-4 bg-brand-primary hover:bg-brand-accent text-white font-bold text-sm rounded-xl shadow-md hover:shadow-lg transition flex items-center justify-center space-x-2">
                    <span>Sign In to Portal</span>
                    <span>&rarr;</span>
                </button>
            </form>
        </div>

        <div class="text-center text-slate-400 text-xs mt-8">
            <span class="block">Secure 256-bit Encrypted Session</span>
            <span class="block mt-0.5">Authorized Personnel Only</span>
        </div>
    </div>
</div>