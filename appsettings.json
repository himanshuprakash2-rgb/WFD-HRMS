{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=WfdHrmsDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "UploadSettings": {
    "MaxFileSizeBytes": 2097152,
    "AllowedMimeTypes": [
      "image/webp"
    ]
  },
  "EmployeeCodeConfig": {
    "DefaultTemplate": "EMP-{BRANCH}-{YEAR}-{SEQ:4}"
  },
  "GoogleDriveSettings": {
    "UseLocalSimulation": true,
    "FolderId": "wfd_hrms_onboarding_docs"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
